{
  "protocol": "modtest-bridge/1.0",
  "protocols": ["modtest-bridge/1.0"],
  "catalog_version": "1.0.0",
  "executor": { "id": "example-client", "version": "0.1.0", "impl": "example mod 0.1.0" },
  "ops": [
    {
      "name": "state.query",
      "title": "Read player/world state",
      "llmSummary": "Read-only snapshot of player and world state, for assertions and evidence.",
      "paramsSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "what": {
            "type": "array",
            "items": { "enum": ["pose", "health", "armor", "held", "offhand", "light", "block", "moving", "all"] },
            "minItems": 1
          },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "z": { "type": "integer" }
        },
        "required": ["what"],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "pose": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "yaw": { "type": "number" }, "pitch": { "type": "number" } } },
          "light": { "type": "object", "additionalProperties": true },
          "blockKnown": { "type": "boolean" },
          "block": { "type": ["string", "null"] },
          "blockIsAir": { "type": ["boolean", "null"] },
          "blockReplaceable": { "type": ["boolean", "null"] },
          "movingKnown": { "type": "boolean" },
          "moving": { "type": ["boolean", "null"] }
        },
        "additionalProperties": true
      },
      "preconditions": [],
      "sideEffects": ["none"],
      "executorId": "example-client",
      "divergence": { "vanilla": "none", "fakePlayer": "n/a (drives the real client player)" },
      "since": "1.0"
    },
    {
      "name": "pose.set",
      "title": "Teleport/rotate the test player",
      "llmSummary": "Put the camera at an exact pose so screenshot A and screenshot B are comparable.",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
          "yaw": { "type": "number", "minimum": -360, "maximum": 360 },
          "pitch": { "type": "number", "minimum": -90, "maximum": 90 },
          "settle_ms": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 250 }
        },
        "required": ["x", "y", "z", "yaw", "pitch"],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": { "pose": { "type": "object" }, "settled": { "type": "boolean" } },
        "required": ["settled"],
        "additionalProperties": true
      },
      "preconditions": [
        { "kind": "permitted-session" },
        { "kind": "flag", "name": "allow-mutate" }
      ],
      "sideEffects": ["player.state"],
      "executorId": "example-client",
      "divergence": { "vanilla": "none", "fakePlayer": "n/a" },
      "since": "1.0"
    },
    {
      "name": "shot.capture",
      "title": "Capture a screenshot and report its bytes",
      "llmSummary": "Byte-level evidence that a frame was rendered. The content of the image is NOT interpreted.",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
        },
        "required": [],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "bytes": { "type": "integer" },
          "format": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "sha256": { "type": "string" },
          "tick": { "type": "integer" },
          "path": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["bytes", "format"],
        "additionalProperties": true
      },
      "preconditions": [],
      "sideEffects": ["telemetry.recording"],
      "executorId": "example-client",
      "divergence": { "vanilla": "none", "fakePlayer": "fake players render nothing client-side" },
      "since": "1.0"
    },
    {
      "name": "bench.read",
      "title": "Read a frame-time/fps sample",
      "llmSummary": "Client-side frame durations with their sampling window; no GPU/vendor counters, not comparable across machines.",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "warmup_frames": { "type": "integer", "minimum": 0, "default": 60 },
          "sample_frames": { "type": "integer", "minimum": 1, "maximum": 600, "default": 300 }
        },
        "required": [],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "warmupFrames": { "type": "integer" },
          "sampleFrames": { "type": "integer" },
          "sampleCount": { "type": "integer" },
          "actualSampleCount": { "type": "integer" },
          "overranWindow": { "type": "boolean" },
          "windowMs": { "type": "integer" },
          "fpsMedian": { "type": "number" },
          "frameMsP95": { "type": "number" },
          "onePercentLow": { "type": "number" },
          "units": { "type": "object" },
          "samplesPath": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["warmupFrames", "sampleFrames", "sampleCount", "actualSampleCount", "overranWindow", "windowMs", "units"],
        "additionalProperties": true
      },
      "preconditions": [],
      "sideEffects": ["telemetry.recording"],
      "executorId": "example-client",
      "divergence": { "vanilla": "n/a", "fakePlayer": "n/a" },
      "since": "1.0"
    }
  ]
}
